# ===== 텔레그램 =====
TELEGRAM_BOT_TOKEN=여기에_봇토큰_입력
# 예: 7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Anthropic (명함 OCR) =====
ANTHROPIC_API_KEY=여기에_Anthropic_API키_입력
# 예: sk-ant-api03-xxxxx...

# ===== Gmail (이메일 발송) =====
GMAIL_ADDRESS=여기에_본인_Gmail_주소
# 예: chooyeanchan@gmail.com
GMAIL_APP_PASSWORD=여기에_앱_비밀번호_16자리
# 예: abcdefghijklmnop (공백 없이)

# ===== Google Sheets =====
GOOGLE_SHEET_ID=여기에_스프레드시트_ID
# 예: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_CREDENTIALS_FILE=credentials.json
# Google Cloud에서 다운로드한 서비스 계정 JSON 파일명

# ===== 내 명함 정보 =====
MY_CARD_IMAGE_PATH=my_card.jpg
# 본인 명함 이미지 파일 (이 폴더에 넣어주세요)

MY_EMAIL_INTRO=안녕하세요! 반갑습니다.\n오늘 명함을 주고받은 [이름]입니다.\n제 명함을 첨부 드리니 연락 주세요!
# 이메일 본문 소개 문구 (자유롭게 수정 가능)

ALLOWED_CHAT_ID=your_telegram_chat_id
